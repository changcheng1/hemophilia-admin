{
  "name": "hemophilia-admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node server.cjs",
    "start": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:test": "run-p type-check \"build-only {@}\" -- && node upload.js",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop hemophilia-admin",
    "pm2:restart": "pm2 restart hemophilia-admin",
    "pm2:delete": "pm2 delete hemophilia-admin",
    "pm2:logs": "pm2 logs hemophilia-admin",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.13.2",
    "connect-history-api-fallback": "^2.0.0",
    "docx": "^9.5.1",
    "echarts": "^6.0.0",
    "element-plus": "^2.12.0",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "file-saver": "^2.0.5",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "path": "^0.12.7",
    "pinia": "^3.0.4",
    "ssh2-sftp-client": "^12.0.1",
    "vue": "^3.5.25",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.6.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.10.4",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "~10.5.1",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "sass-embedded": "^1.97.0",
    "typescript": "~5.9.0",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.2.4",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.1.5"
  }
}
